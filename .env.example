# DahliaSeedling environment template.
#
# Copy this file to `.env.local` (git-ignored) and fill in the values.
# This file contains NO secrets. Keep real values out of version control.

# ---------------------------------------------------------------------------
# Browser-safe Supabase configuration (required). NEXT_PUBLIC_* values are
# bundled into client code, so they must never be secret.
# ---------------------------------------------------------------------------

# Local development: the URL printed by `npm run supabase:status` (default below).
# Preview/production: your Supabase project URL, for example https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The publishable key from `npm run supabase:status` locally, or from the Supabase dashboard
# (Project Settings > API) for a remote project. Legacy projects may use the anon key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public, not secret). Set it in Vercel to show the bot check on sign-up, sign-in and password reset. The
# matching secret is entered only in the Supabase dashboard (Attack Protection > CAPTCHA), never here. Local development can leave this
# empty, so no challenge is shown. Cloudflare's test keys can be used locally.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets (NOT read by Phase 0 code). Never prefix these with NEXT_PUBLIC_.
# Phase 1 will document the secret key here if server-side admin access is required.
# ---------------------------------------------------------------------------
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Availability email (Phase 8). Only the Notify-me availability alert is sent by email. All of these are
# server-only: never prefix them with NEXT_PUBLIC_, and never paste real values into this file.
#   RESEND_API_KEY      Resend API key for the transactional provider (secret).
#   EMAIL_FROM_ADDRESS  From address on a sending domain you control and have verified in Resend,
#                       for example "DahliaSeedling <notifications@your-verified-domain>".
#   APP_BASE_URL        Public origin of this deployment, used to build links (https in production).
#   CRON_SECRET         Bearer secret the platform scheduler sends to /api/email/deliver (secret).
#   SUPABASE_SECRET_KEY Used only by the delivery worker, to claim and record outbox rows (secret).
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=
# APP_BASE_URL=http://localhost:3000
# CRON_SECRET=
# SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Later phases only. Do NOT set these to boot Phase 0.
#   - media processing / storage configuration (Phase 3)
#   - optional recognition / transcription providers (Phase 9)
# ---------------------------------------------------------------------------
